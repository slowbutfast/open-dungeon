{
  "name": "local-llm-testing-backend",
  "version": "1.0.0",
  "description": "Node.js refactored backend for Local LLM Retro Adventure Game",
  "main": "web/server.js",
  "scripts": {
    "start": "node web/server.js",
    "test:fast": "python3 -m pytest -m unit",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "python3 -m pytest -m e2e",
    "test:all": "python3 -m pytest tests/ -v --ignore=tests/test_cli_behavior.py --ignore=tests/test_pty_integration.py --ignore=tests/simulate_playtest.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.50.0",
    "uuid": "^9.0.1",
    "vectra": "^0.15.0",
    "zod": "^4.4.3"
  },
  "type": "module"
}
