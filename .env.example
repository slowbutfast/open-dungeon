# ============================================================
# LLM Backend Configuration — Template
# ============================================================

# Backend selection: "openrouter" (online) or "lmstudio" (local)
# LLM_BACKEND=openrouter

# OpenRouter API key (required when LLM_BACKEND=openrouter)
# Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter model for text generation
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Embedding model for vector memory (free tier available on OpenRouter)
# OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# DeepSeek reasoning effort: "low", "medium", "high" ("low" = small thinking)
# REASONING_EFFORT=low

# Max tokens range (min:max) — wider for online models with large context
# MAX_TOKENS_RANGE=50:4096

# ============================================================
# LM Studio (local) — used when LLM_BACKEND=lmstudio
# ============================================================
# LM_STUDIO_HOST=127.0.0.1
# LM_STUDIO_PORT=1234