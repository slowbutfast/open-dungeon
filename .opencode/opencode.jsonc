{
  "$schema": "https://opencode.ai/config.json",
  "environment": {
    "SAVE_DIR": "game/playtest/adventures",
    "MOCK_LLM": "0"
  },
  "mcp": {
    "open-dungeon": {
      "type": "local",
      "command": [
        "node",
        "mcp/server.js"
      ]
    }
  },
  "permission": {
    "read": {
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*": "allow"
    },
    "dungeon_*": "allow",
    "open-dungeon*": "allow",
    "open_dungeon*": "allow",
    "open-dungeon/*": "allow",
    "open_dungeon/*": "allow",
    "mcp": {
      "open-dungeon/*": "allow",
      "open_dungeon/*": "allow",
      "*": "allow"
    }
  }
}
