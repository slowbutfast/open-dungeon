{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "open-dungeon": {
      "type": "local",
      "command": [
        "node",
        "mcp/server.js"
      ],
      "environment": {
        "MOCK_LLM": "1"
      }
    }
  },
  "permission": {
    "dungeon_*": "allow",
    "open-dungeon/*": "allow",
    "mcp": {
      "open-dungeon/*": "allow",
      "*": "ask"
    }
  }
}
