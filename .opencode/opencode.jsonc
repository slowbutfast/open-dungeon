{
  "$schema": "https://opencode.ai/config.json",
  // NOTE: OpenCode's Config schema sets additionalProperties:false and has no
  // top-level `environment` key, so one here is a hard validation failure, not
  // an ignored extra. Per-server `environment` under `mcp` IS valid and is the
  // only supported way to inject env from this file.
  //
  // Default to the playtest sandbox + offline mock: autonomous agents must
  // never write production saves or burn real API budget. Flip MOCK_LLM to "0"
  // only for deliberate real-model fidelity runs.
  //
  // This covers the MCP server only. Anything the agent starts from bash is a
  // separate process tree that inherits the shell's env, not this block:
  //   - web/server.js self-defaults MOCK_LLM=1 (web/server.js:20).
  //   - SAVE_DIR has no safe default — engine/index.js:53 falls back to
  //     game/adventures, the production tree. Export SAVE_DIR in the shell
  //     before launching bash-side servers, or pass saveDir explicitly.
  "mcp": {
    "open-dungeon": {
      "type": "local",
      "command": [
        "node",
        "mcp/server.js"
      ],
      "environment": {
        "SAVE_DIR": "game/playtest/adventures",
        "MOCK_LLM": "1"
      }
    }
  },
  "permission": {
    "read": {
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*": "allow"
    },
    "dungeon_*": "allow",
    "open-dungeon*": "allow",
    "open_dungeon*": "allow",
    "open-dungeon/*": "allow",
    "open_dungeon/*": "allow",
    "mcp": {
      "open-dungeon/*": "allow",
      "open_dungeon/*": "allow",
      "*": "allow"
    }
  }
}
